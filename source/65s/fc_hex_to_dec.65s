FC_Hex_To_Dec
    LDX #$04
    LDY #$00
.FC_Hex_To_Dec_Cmp
    LDA FC_Hex_Data_H
    CMP .FC_Hex_To_Unit_Data_H,X
    BCC .FC_Hex_To_Dec_Continue
    BNE .FC_Hex_To_Dec_Sub
    LDA FC_Hex_Data_L
    CMP .FC_Hex_To_Unit_Data_L,X
    BCC .FC_Hex_To_Dec_Continue
.FC_Hex_To_Dec_Sub
    LDA FC_Hex_Data_L
    SBC .FC_Hex_To_Unit_Data_L,X
    STA FC_Hex_Data_L
    LDA FC_Hex_Data_H
    SBC .FC_Hex_To_Unit_Data_H,X
    STA FC_Hex_Data_H
    INY
    BNE .FC_Hex_To_Dec_Cmp
.FC_Hex_To_Dec_Continue
    PHA
    TYA
    STA FC_Dec_Data_1,X
    PLA
    LDY #$00
    DEX
    BPL .FC_Hex_To_Dec_Cmp
    RTS

