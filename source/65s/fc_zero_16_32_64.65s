    LDY #$07
FC_Is_Zero_64_Data
    LDA (FC_Data_Src_L),Y
    BNE FC_Is_Zero_64_End
    DEY
    BPL FC_Is_Zero_64_Data
    LDA #$00
FC_Is_Zero_64_End
