;=================================================
;64位整数检测是否为0
;最多耗时周期: 84
;编译指令长度: 42
FC_Is_Zero_64_Fast
    LDY #$07
FC_Is_Zero_64_Fast_Data
    LDA (FC_Data_Src_L),Y
    BNE FC_Is_Zero_64_Fast_End
    DEY
    LDA (FC_Data_Src_L),Y
    BNE FC_Is_Zero_64_Fast_End
    DEY
    LDA (FC_Data_Src_L),Y
    BNE FC_Is_Zero_64_Fast_End
    DEY
    LDA (FC_Data_Src_L),Y
    BNE FC_Is_Zero_64_Fast_End
    DEY
    LDA (FC_Data_Src_L),Y
    BNE FC_Is_Zero_64_Fast_End
    DEY
    LDA (FC_Data_Src_L),Y
    BNE FC_Is_Zero_64_Fast_End
    DEY
    LDA (FC_Data_Src_L),Y
    BNE FC_Is_Zero_64_Fast_End
    DEY
    LDA (FC_Data_Src_L),Y
    BNE FC_Is_Zero_64_Fast_End
FC_Is_Zero_64_Fast_End
    RTS

;=================================================
;NES 入口
    .ORG $FFFA
    .DW 0
    .DW Reset_Program
    .DW 0
    