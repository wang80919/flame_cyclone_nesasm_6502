;=================================================
;进制转换
;FlameCyclone
;2024.8.7
;=================================================
;进制转换
;FC_HEX_To_Dec_8        最差耗时 134      指令长度: 29
;=================================================
;进制转换
FC_HEX_Data_L               = $10
FC_HEX_Data_H               = $11
FC_Dec_16                   = $12
FC_Dec_1                    = FC_Dec_16 + 0
FC_Dec_10                   = FC_Dec_16 + 1
FC_Dec_100                  = FC_Dec_16 + 2

;=================================================
    ;.INESPRG 1      ;16KB PRG 数量, $01-$EF8(1-3832),即16-61,312 KB
    ;.INESCHR 0       ;8KB CHR 数量,$01-$EF8(1-3832),即0-30,656 KB
    ;.INESMAP 4          ;Mapper号 (0-4095)
    ;.BANK 1
    .ORG $E000
    
Test_Hex = 11111
;=================================================
Reset_Program
    SEI
    CLD
    LDA #<Test_Hex
    STA FC_HEX_Data_L
    LDA #>Test_Hex
    STA FC_HEX_Data_H
    JSR FC_HEX_To_Dec_Ex
    
    LDA #$00
    STA $2000
    STA $2001
    LDA #$C0
    STA $4017
    STA $E000
    LDX #$FF
    TXS
    
.Loop
    JMP .Loop

;=================================================
HEX_TO_DEC_16_CMP .MACRO _Hex_L,_Hex_H,_Value,_Unit,_Num,_Over
        LDA _Hex_H
        CMP #>_Value
        BCC .Label_End
        BNE .Label_Calc
        LDA _Hex_L
        CMP #<_Value
        BCC .Label_End
.Label_Calc
        LDA _Hex_L
        SBC #<_Value
        STA _Hex_L
        LDA _Hex_H
        SBC #>_Value
        STA _Hex_H
        LDA #_Value / _Unit
        STA _Num
        JMP _Over
.Label_End
    
    .ENDM

;=================================================
HEX_TO_DEC_UNIT_CMP .MACRO _Hex_L,_Hex_H,_Unit,_Start,_Over
        LDA _Hex_H
        CMP #>_Unit
        BCC .Label_Over
        BNE .Label_Start
        LDA _Hex_L
        CMP #<_Unit
        BCC .Label_Over
.Label_Start
        JMP _Start
.Label_Over
        JMP _Over
    .ENDM

;=================================================
